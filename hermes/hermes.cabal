cabal-version:      3.0
name:               hermes
version:            1.0.0
synopsis:           HERMES - Satelite de Retransmision SHA-256

executable hermes
    main-is:          Main.hs
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -O2

    build-depends:
          base          >=4.17
        , aeson         >=2.1
        , bytestring    >=0.11
        , cryptonite    >=0.30
        , http-conduit  >=2.3
        , memory        >=0.18
        , network       >=3.1
        , text          >=2.0
        , time          >=1.12
